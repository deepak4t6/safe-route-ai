# ==============================================================================
# Safe Route AI — Environment Configuration Template
# Copy this file to .env in your root, backend, and frontend directories as needed
# ==============================================================================

# Node.js Express Backend Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL with PostGIS Connection String
# (Leave empty to use built-in self-contained in-memory fallback for instant testing)
DATABASE_URL=postgresql://postgres:password@localhost:5432/saferoute_db

# JSON Web Token Secret
JWT_SECRET=safe_route_ai_production_super_secret_jwt_key_2026_xyz
JWT_EXPIRES_IN=7d

# Python AI Engine Microservice URL
AI_ENGINE_URL=http://localhost:8000

# Mapbox Access Token (Stored in Backend .env - Never exposed directly in browser)
# Get your free public token from https://account.mapbox.com
# (If left empty, system automatically uses high-performance OpenStreetMap Nominatim & OSRM)
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0...

# Frontend Configuration (Vite)
VITE_API_URL=/api
